<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Self-update (see com.thumbtrek.app.update). ThumbTrek is sideloaded, so nothing
         else is going to update it. -->
    <!-- Lets the app hand its own downloaded APK to PackageInstaller. On API 26+ the user
         must additionally grant "install unknown apps" for ThumbTrek in system settings;
         the updater asks for that once, from Settings. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Used to hold the multi-megabyte APK download back until the phone is on Wi-Fi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- API 31+, normal permission. Asks the system to let an app update *itself* without
         the confirmation dialog. The system frequently refuses (notably when the current
         copy was installed by hand rather than by us), so it is strictly a best case —
         the updater always handles being told "ask the user" instead. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Package visibility for the custom-app picker (Settings → Tracked apps). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ThumbTrekApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThumbTrek">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Invite links. `Identity.inviteLink` produces
                 https://thumbtrek.adityamer.dev/i/<code>, and the web dashboard serves that URL,
                 so a tapped invite has to be able to hand the code to the app.

                 Two filters, because neither alone is enough:

                 - The custom scheme works the moment the app is installed, with no server
                   and no verification. It is what the invite page actually triggers.
                 - The https filter is the one that makes a real link open the app, but on
                   Android 12+ an unverified web filter is ignored by default — the user
                   would have to enable "Open supported links" by hand. autoVerify fixes
                   that only once web/.well-known/assetlinks.json carries the release
                   certificate's SHA-256; until then this filter is simply inert, which is
                   why the custom scheme is not redundant. See web/README.md. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="thumbtrek" android:host="i" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="thumbtrek.adityamer.dev"
                    android:pathPrefix="/i/" />
            </intent-filter>
        </activity>

        <!-- Invisible, finishes immediately. Exists so the "update ready" notification has a
             foreground activity to launch Android's install-confirmation screen from —
             broadcast receivers are not allowed to start activities. -->
        <activity
            android:name=".update.UpdateInstallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- PackageInstaller reports session outcomes here. -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <service
            android:name=".track.ScrollTrackerService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".widget.TrekWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- App Startup. WorkManager already contributes this provider; merging into it is
             how the updater gets its periodic check scheduled on process start without
             editing ThumbTrekApp. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.thumbtrek.app.update.UpdateStartupInitializer"
                android:value="androidx.startup" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.thumbtrek.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
