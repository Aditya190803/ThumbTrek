<?xml version="1.0" encoding="utf-8"?>
<!-- No android:packageNames: the four built-in feeds plus any user-added apps must all
     wake the service. The code filters events against Prefs.trackedApps (an in-memory
     read) before counting a pixel, so untracked apps cost one string compare each. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:notificationTimeout="50"
    android:description="@string/service_description" />
