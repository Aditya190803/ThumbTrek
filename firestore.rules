rules_version = '2';

// Paste into Firebase Console → Firestore Database → Rules.
//
// Composite indexes the boards need (deploy firestore.indexes.json, or accept the
// auto-link in the first error):
//   users:  weekKey  ASC, weekUm  DESC
//   users:  monthKey ASC, monthUm DESC
// The legacy weekPixels/monthPixels pairs stay indexed until the last old client is gone.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Distances that cross the network are integer micrometres (`*Um`) — pixels are not
    // comparable between a 560dpi phone, a 320dpi phone and a browser's CSS pixel.
    // See docs/sync-protocol.md §1. The `*Pixels` fields are legacy: still written by the
    // Android app so old builds keep appearing on the board, never ranked on.
    function nonNegInt(value) {
      return value is int && value >= 0;
    }

    // users/{uid}: { displayName, photoUrl, friendCode, weekKey, weekPixels,
    //                monthKey, monthPixels, totalPixels,
    //                weekUm, monthUm, totalUm, sources }
    // A doc only exists while its owner has opted in — leaving the leaderboard deletes it.
    // Readable by any signed-in user because that *is* the global board; it holds a handful
    // of distance numbers and a name the owner chose (possibly an anonymous handle).
    // Per-day history is NOT here — it lives in the private days subcollection below.
    match /users/{uid} {
      function validScore() {
        let data = request.resource.data;
        return data.keys().hasOnly(
                 ['displayName', 'photoUrl', 'friendCode',
                  'weekKey', 'weekPixels', 'monthKey', 'monthPixels', 'totalPixels',
                  'weekUm', 'monthUm', 'totalUm', 'sources']
               )
               && data.displayName is string
               && data.displayName.size() <= 64
               && data.photoUrl is string
               && data.photoUrl.size() <= 512
               && data.friendCode is string
               && data.friendCode.size() <= 16
               && data.weekKey is string
               && data.weekKey.size() <= 16
               && data.monthKey is string
               && data.monthKey.size() <= 16
               && (!('weekPixels' in data) || nonNegInt(data.weekPixels))
               && (!('monthPixels' in data) || nonNegInt(data.monthPixels))
               && (!('totalPixels' in data) || nonNegInt(data.totalPixels))
               && (!('weekUm' in data) || nonNegInt(data.weekUm))
               && (!('monthUm' in data) || nonNegInt(data.monthUm))
               && (!('totalUm' in data) || nonNegInt(data.totalUm))
               // sources: { android: {...}, web: {...} } — one entry per client kind.
               // Contents aren't walked field-by-field (rules can't iterate a map), but the
               // whole document is only ever writable by its owner, so the blast radius of
               // a malformed entry is the owner's own board row.
               && (!('sources' in data)
                   || (data.sources is map && data.sources.keys().size() <= 8));
      }

      allow read: if signedIn();
      allow create, update: if isSelf(uid) && validScore();
      allow delete: if isSelf(uid);

      // users/{uid}/days/{date}__{source} = { date, source, um, apps, updatedAt }
      // The per-day, per-source ledger the web dashboard charts. Private to its owner:
      // opting in to the leaderboard publishes three totals, never a day-by-day history.
      // One doc per source per day means no two clients ever write the same document,
      // so concurrent phone + extension syncs cannot clobber each other.
      match /days/{dayId} {
        function validDay() {
          let data = request.resource.data;
          return data.keys().hasOnly(['date', 'source', 'um', 'apps', 'updatedAt'])
                 && data.date is string
                 && data.date.size() == 10
                 && data.source is string
                 && data.source.size() <= 16
                 // The doc id is the composite key; a mismatch would let one source
                 // overwrite another's day by choosing a misleading id.
                 && dayId == data.date + '__' + data.source
                 && nonNegInt(data.um)
                 && (!('apps' in data)
                     || (data.apps is map && data.apps.keys().size() <= 64));
        }

        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validDay();
        allow delete: if isSelf(uid);
      }

      // Friendship edges carry { since, status } plus the writer's real identity in
      // { name, photo }: "pending" until the other side accepts, "accepted" after.
      // Old edges with no status read as accepted. The edge on YOUR list carries the
      // OTHER person's identity — that is what lets friends see each other's real names
      // while the public board row stays anonymous: edges are readable only by their
      // owner, so a real name here is visible to exactly one friend, never the board.
      // Each write stamps the WRITER's identity (request writes both edges with theirs;
      // accepting stamps only the other side's edge, preserving the requester's).
      match /friends/{friendUid} {
        function validEdge() {
          return request.resource.data.keys().hasOnly(['since', 'status', 'name', 'photo'])
                 && (!('status' in request.resource.data)
                     || request.resource.data.status in ['pending', 'accepted'])
                 && (!('name' in request.resource.data)
                     || (request.resource.data.name is string
                         && request.resource.data.name.size() <= 64))
                 && (!('photo' in request.resource.data)
                     || (request.resource.data.photo is string
                         && request.resource.data.photo.size() <= 512));
        }
        allow read: if isSelf(uid);
        allow create, update: if (isSelf(uid) || isSelf(friendUid)) && validEdge();
        allow delete: if isSelf(uid) || isSelf(friendUid);
      }
    }

    // friendCodes/{code} = { uid }: the invite lookup index.
    // `get` only, never `list`: you have to already know a code to resolve it, and the
    // collection can't be swept for uids. A code always points at whoever wrote it, and
    // create-vs-update means only its owner can repoint one once claimed.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // archive/{weekKey}/scores/{uid} = { displayName, photoUrl, pixels, um }:
    // one frozen copy of every week's board so last week's podium survives the weekly
    // reset. You can write your own row into any week's archive (the client knows the
    // week key better than the rules can compute it), but never anybody else's.
    // `um` is the ranked figure; `pixels` is kept for rows frozen before the unit change.
    match /archive/{weekKey}/scores/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
                            && request.resource.data.keys().hasOnly(
                                 ['displayName', 'photoUrl', 'pixels', 'um'])
                            && request.resource.data.displayName is string
                            && request.resource.data.displayName.size() <= 64
                            && request.resource.data.photoUrl is string
                            && request.resource.data.photoUrl.size() <= 512
                            && (!('pixels' in request.resource.data)
                                || nonNegInt(request.resource.data.pixels))
                            && (!('um' in request.resource.data)
                                || nonNegInt(request.resource.data.um));
      allow delete: if isSelf(uid);
    }
  }
}
