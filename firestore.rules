rules_version = '2';

// Paste into Firebase Console → Firestore Database → Rules.
//
// Composite indexes the boards need (deploy firestore.indexes.json, or accept the
// auto-link in the first error):
//   users:  weekKey  ASC, weekUm  DESC
//   users:  monthKey ASC, monthUm DESC
// The legacy weekPixels/monthPixels pairs stay indexed until the last old client is gone.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Distances that cross the network are integer micrometres (`*Um`) — pixels are not
    // comparable between a 560dpi phone, a 320dpi phone and a browser's CSS pixel.
    // See docs/sync-protocol.md §1. The `*Pixels` fields are legacy: still written by the
    // Android app so old builds keep appearing on the board, never ranked on.
    function nonNegInt(value) {
      return value is int && value >= 0;
    }

    // Premium (docs/sync-protocol.md §9). The shared limit and groups are Premium
    // features. While billing is not enforced every signed-in account passes, because
    // there is nothing to buy yet. The day billing ships, change billingEnforced() to
    // return true and redeploy: the entitlement record then decides, and it is written
    // by the billing backend only (see /entitlements below).
    function billingEnforced() {
      return false;
    }

    function premium() {
      let record = /databases/$(database)/documents/entitlements/$(request.auth.uid);
      return !billingEnforced() || (exists(record) && get(record).data.premium == true);
    }

    // users/{uid}: { displayName, photoUrl, friendCode, weekKey, weekPixels,
    //                monthKey, monthPixels, totalPixels,
    //                weekUm, monthUm, totalUm, sources }
    // A doc only exists while its owner has opted in — leaving the leaderboard deletes it.
    // Readable by any signed-in user because that *is* the global board; it holds a handful
    // of distance numbers and a name the owner chose (possibly an anonymous handle).
    // Per-day history is NOT here — it lives in the private days subcollection below.
    match /users/{uid} {
      function validScore() {
        let data = request.resource.data;
        return data.keys().hasOnly(
                 ['displayName', 'photoUrl', 'friendCode',
                  'weekKey', 'weekPixels', 'monthKey', 'monthPixels', 'totalPixels',
                  'weekUm', 'monthUm', 'totalUm', 'sources']
               )
               && data.displayName is string
               && data.displayName.size() <= 64
               && data.photoUrl is string
               && data.photoUrl.size() <= 512
               && data.friendCode is string
               && data.friendCode.size() <= 16
               && data.weekKey is string
               && data.weekKey.size() <= 16
               && data.monthKey is string
               && data.monthKey.size() <= 16
               && (!('weekPixels' in data) || nonNegInt(data.weekPixels))
               && (!('monthPixels' in data) || nonNegInt(data.monthPixels))
               && (!('totalPixels' in data) || nonNegInt(data.totalPixels))
               && (!('weekUm' in data) || nonNegInt(data.weekUm))
               && (!('monthUm' in data) || nonNegInt(data.monthUm))
               && (!('totalUm' in data) || nonNegInt(data.totalUm))
               // sources: { android: {...}, web: {...} } — one entry per client kind.
               // Contents aren't walked field-by-field (rules can't iterate a map), but the
               // whole document is only ever writable by its owner, so the blast radius of
               // a malformed entry is the owner's own board row.
               && (!('sources' in data)
                   || (data.sources is map && data.sources.keys().size() <= 8));
      }

      allow read: if signedIn();
      allow create, update: if isSelf(uid) && validScore();
      allow delete: if isSelf(uid);

      // users/{uid}/days/{date}__{source} = { date, source, um, apps, updatedAt }
      // The per-day, per-source ledger the web dashboard charts. Private to its owner:
      // opting in to the leaderboard publishes three totals, never a day-by-day history.
      // One doc per source per day means no two clients ever write the same document,
      // so concurrent phone + extension syncs cannot clobber each other.
      match /days/{dayId} {
        function validDay() {
          let data = request.resource.data;
          return data.keys().hasOnly(['date', 'source', 'um', 'apps', 'updatedAt'])
                 && data.date is string
                 && data.date.size() == 10
                 && data.source is string
                 && data.source.size() <= 16
                 // The doc id is the composite key; a mismatch would let one source
                 // overwrite another's day by choosing a misleading id.
                 && dayId == data.date + '__' + data.source
                 && nonNegInt(data.um)
                 && (!('apps' in data)
                     || (data.apps is map && data.apps.keys().size() <= 64));
        }

        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validDay();
        allow delete: if isSelf(uid);
      }

      // users/{uid}/settings/limits = { limitUm, setAt, source, updatedAt }
      // The daily limit shared between this account's clients (§7). limitUm 0 means "no
      // limit"; setAt is the wall-clock millisecond of the edit, and the newest wins on
      // every client. Private to its owner. The document existing is what "shared" means.
      match /settings/{settingId} {
        function validLimits() {
          let data = request.resource.data;
          return settingId == 'limits'
                 && data.keys().hasOnly(['limitUm', 'setAt', 'source', 'updatedAt'])
                 && nonNegInt(data.limitUm)
                 && nonNegInt(data.setAt)
                 && data.source is string
                 && data.source.size() <= 16;
        }

        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid) && validLimits() && premium();
        allow delete: if isSelf(uid);
      }

      // Friendship edges carry { since, status } plus the writer's real identity in
      // { name, photo }: "pending" until the other side accepts, "accepted" after.
      // Old edges with no status read as accepted. The edge on YOUR list carries the
      // OTHER person's identity — that is what lets friends see each other's real names
      // while the public board row stays anonymous: edges are readable only by their
      // owner, so a real name here is visible to exactly one friend, never the board.
      // Each write stamps the WRITER's identity (request writes both edges with theirs;
      // accepting stamps only the other side's edge, preserving the requester's).
      match /friends/{friendUid} {
        function validEdge() {
          return request.resource.data.keys().hasOnly(['since', 'status', 'name', 'photo'])
                 && (!('status' in request.resource.data)
                     || request.resource.data.status in ['pending', 'accepted'])
                 && (!('name' in request.resource.data)
                     || (request.resource.data.name is string
                         && request.resource.data.name.size() <= 64))
                 && (!('photo' in request.resource.data)
                     || (request.resource.data.photo is string
                         && request.resource.data.photo.size() <= 512));
        }
        allow read: if isSelf(uid);
        allow create, update: if (isSelf(uid) || isSelf(friendUid)) && validEdge();
        allow delete: if isSelf(uid) || isSelf(friendUid);
      }
    }

    // friendCodes/{code} = { uid }: the invite lookup index.
    // `get` only, never `list`: you have to already know a code to resolve it, and the
    // collection can't be swept for uids. A code always points at whoever wrote it, and
    // create-vs-update means only its owner can repoint one once claimed.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // entitlements/{uid} = { premium, until }: who has paid (§9).
    // Readable by its owner and writable by nobody: only the billing backend, through the
    // Admin SDK, which bypasses these rules. A client can never grant itself Premium.
    match /entitlements/{uid} {
      allow get: if isSelf(uid);
      allow write: if false;
    }

    // groups/{groupId} = { name, owner, code, members[], createdAt, challenge? } (§8).
    // A private board for up to 50 people. Readable only by its members. You become a
    // member by adding exactly yourself, which you can only do if you were handed the
    // group's id, and the only way to learn an id is to resolve its code below.
    match /groups/{groupId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      function validChallenge(c) {
        return c is map
               && c.keys().hasOnly(['title', 'kind', 'startsOn', 'endsOn'])
               && c.title is string && c.title.size() > 0 && c.title.size() <= 60
               && c.kind in ['least', 'most']
               && c.startsOn is string && c.startsOn.size() == 10
               && c.endsOn is string && c.endsOn.size() == 10;
      }

      function validGroup() {
        let data = request.resource.data;
        return data.keys().hasOnly(['name', 'owner', 'code', 'members', 'createdAt', 'challenge'])
               && data.name is string && data.name.size() > 0 && data.name.size() <= 40
               && data.owner is string
               && data.code is string && data.code.size() == 8
               && data.members is list
               && data.members.size() >= 1 && data.members.size() <= 50
               && (!('challenge' in data) || validChallenge(data.challenge));
      }

      function onlyMembersChanged() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
      }

      // "members grew by exactly me". arrayUnion on an existing member changes nothing,
      // and that no-op is allowed too so joining twice is not an error.
      function joining() {
        return onlyMembersChanged()
               && request.resource.data.members.hasAll(resource.data.members)
               && request.auth.uid in request.resource.data.members
               && request.resource.data.members.size() <= 50
               && (request.resource.data.members.size() == resource.data.members.size() + 1
                   || request.resource.data.members == resource.data.members);
      }

      // "members shrank by exactly me". The owner cannot leave; they delete the group.
      function leaving() {
        return onlyMembersChanged()
               && resource.data.members.hasAll(request.resource.data.members)
               && request.resource.data.members.size() == resource.data.members.size() - 1
               && !(request.auth.uid in request.resource.data.members)
               && request.auth.uid != resource.data.owner;
      }

      // The owner renames, sets or clears the challenge, and can remove members. They
      // cannot hand the group away, change its code, or remove themselves.
      function ownerEditing() {
        return resource.data.owner == request.auth.uid
               && validGroup()
               && request.resource.data.owner == resource.data.owner
               && request.resource.data.code == resource.data.code
               && request.auth.uid in request.resource.data.members;
      }

      allow read: if isMember();
      allow create: if signedIn()
                    && premium()
                    && validGroup()
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (ownerEditing() || joining() || leaving());
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // groups/{groupId}/progress/{uid}__{source}
      //   = { uid, source, name, photo, windowKey, um, updatedAt }
      // One member's distance from one source inside the group's current window. The doc
      // id embeds the writer and the source, the same single-writer trick as the day
      // ledger. `name` and `photo` are the member's real identity: a group is private to
      // the people holding its code, like a friends list.
      match /progress/{progressId} {
        function group() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        function validProgress() {
          let data = request.resource.data;
          return data.keys().hasOnly(['uid', 'source', 'name', 'photo', 'windowKey', 'um', 'updatedAt'])
                 && data.uid == request.auth.uid
                 && data.source is string && data.source.size() <= 16
                 && progressId == data.uid + '__' + data.source
                 && data.name is string && data.name.size() <= 64
                 && data.photo is string && data.photo.size() <= 512
                 && data.windowKey is string && data.windowKey.size() <= 32
                 && nonNegInt(data.um);
        }

        allow read: if signedIn() && request.auth.uid in group().members;
        allow create, update: if signedIn()
                              && request.auth.uid in group().members
                              && validProgress();
        // Your own, always (so leaving cleans up after itself); anyone's, for the owner,
        // so deleting a group does not leave names behind.
        allow delete: if signedIn()
                      && (resource.data.uid == request.auth.uid
                          || group().owner == request.auth.uid);
      }
    }

    // groupCodes/{code} = { groupId }: the join lookup. `get` only, never `list`, so the
    // collection cannot be swept for groups. Created in the same batch as its group, and
    // only by that group's owner, for that group's own code.
    match /groupCodes/{code} {
      function target() {
        return /databases/$(database)/documents/groups/$(request.resource.data.groupId);
      }

      allow get: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['groupId'])
                    && request.resource.data.groupId is string
                    && getAfter(target()).data.owner == request.auth.uid
                    && getAfter(target()).data.code == code;
      allow delete: if signedIn()
                    && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.owner
                       == request.auth.uid;
    }

    // archive/{weekKey}/scores/{uid} = { displayName, photoUrl, pixels, um }:
    // one frozen copy of every week's board so last week's podium survives the weekly
    // reset. You can write your own row into any week's archive (the client knows the
    // week key better than the rules can compute it), but never anybody else's.
    // `um` is the ranked figure; `pixels` is kept for rows frozen before the unit change.
    match /archive/{weekKey}/scores/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
                            && request.resource.data.keys().hasOnly(
                                 ['displayName', 'photoUrl', 'pixels', 'um'])
                            && request.resource.data.displayName is string
                            && request.resource.data.displayName.size() <= 64
                            && request.resource.data.photoUrl is string
                            && request.resource.data.photoUrl.size() <= 512
                            && (!('pixels' in request.resource.data)
                                || nonNegInt(request.resource.data.pixels))
                            && (!('um' in request.resource.data)
                                || nonNegInt(request.resource.data.um));
      allow delete: if isSelf(uid);
    }
  }
}
