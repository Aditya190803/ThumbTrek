rules_version = '2';

// Paste into Firebase Console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // users/{uid}: { displayName, photoUrl, friendCode, weekKey, weekPixels }
    // A doc only exists while its owner has opted in — leaving the leaderboard deletes it.
    // Readable by any signed-in user because that *is* the global board; it holds one
    // week's distance and a name the owner chose (possibly an anonymous handle), nothing more.
    match /users/{uid} {
      function validScore() {
        return request.resource.data.keys().hasOnly(
                 ['displayName', 'photoUrl', 'friendCode', 'weekKey', 'weekPixels']
               )
               && request.resource.data.displayName is string
               && request.resource.data.displayName.size() <= 64
               && request.resource.data.photoUrl is string
               && request.resource.data.photoUrl.size() <= 512
               && request.resource.data.friendCode is string
               && request.resource.data.friendCode.size() <= 16
               && request.resource.data.weekKey is string
               && request.resource.data.weekKey.size() <= 16
               && request.resource.data.weekPixels is int
               && request.resource.data.weekPixels >= 0;
      }

      allow read: if signedIn();
      allow create, update: if isSelf(uid) && validScore();
      allow delete: if isSelf(uid);

      // Friendship is symmetric, so adding a friend writes both edges in one batch:
      // you may edit your own list, or put/remove *yourself* on someone else's. Neither
      // side can touch an edge it isn't part of, and a friend list is private to its owner.
      match /friends/{friendUid} {
        allow read: if isSelf(uid);
        allow create, update: if (isSelf(uid) || isSelf(friendUid))
                              && request.resource.data.keys().hasOnly(['since']);
        allow delete: if isSelf(uid) || isSelf(friendUid);
      }
    }

    // friendCodes/{code} = { uid }: the invite lookup index.
    // `get` only, never `list`: you have to already know a code to resolve it, and the
    // collection can't be swept for uids. A code always points at whoever wrote it, and
    // create-vs-update means only its owner can repoint one once claimed.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
